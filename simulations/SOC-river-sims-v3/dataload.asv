%% ========================================================================
% DATALOAD FUNCTIONS
% ========================================================================

function [inflow, soc, params, sysparams] = dataload()
    % Load and process hydro simulation data from multiple CSV files
    %
    % Outputs:
    %   inflow  - USACE inflow data table
    %   params  - Fitted OLS model parameters for forecasting inflow
    %   sysparams - Reservoir operation parameters
    
    % Define file path
    inflow_path = '/Users/elizacohn/Desktop/cascaded-hydro/simulation-data/inflow-hourly.csv';
    soc_path = '/Users/elizacohn/Desktop/cascaded-hydro/simulation-data/soc.csv';

    % USACE Inflow Data
    inflow = readtable(inflow_path);
    inflow.datetime = datetime(inflow.datetime, 'InputFormat', 'yyyy-MM-dd HH:mm:ss');
    inflow = inflow(:, {'datetime', 'mcn_inflow', 'jda_inflow', 'tda_inflow', 'bon_inflow'});

    % 1 kcfs sustained for one hour equals 0.0826446 kaf
    K = 0.0826446;

    % USACE DOC Data 
    soc= readtable(soc_path);
    soc.datetime = datetime(soc.datetime, 'InputFormat', 'yyyy-MM-dd HH:mm:ss');
    soc = soc(:, {'datetime','mcn_soc', 'jda_soc', 'tda_soc', 'bon_soc'});
    
    % Seasonal Forecasting Parameters
    params(1) = struct( ...
        'season',   'dry', ...    % Hydrology season
        'start_day', 250, ...     % Sep 7th (start of dry season)
        'coef0',    -0.0013, ...  % Regression intercept
        'coef1',    0.83,  ...    % Regression coef for inflow_lag
        'coef2',    0.17,  ...    % Regression coef for outflow_lag  
        'AR_const', 0.0020, ...   % DIU params
        'AR_coef',  0.950, ...    % DIU inflow_lag1
        'AR_std',   0.003, ...    % DIU residual variance % 0.0028
        'omega',    0.0001,  ...  % GARCH-X params  % (0.006^2),
        'alpha',    0.004,   ...  % GARCH-X params % 0.8, 0.008
        'gamma',    0.002);.     % GARCH-X params % 6.6e-4 0.004

    % Conditional mean: q_t = coef0 + coef1*q_(t-1) + coef2*u_(t-L)
    params(1) = struct( ...
        'name',          'John Day', ...
        'unit',          2, ...
        'upstream_unit', 1, ...
        'release_lag',   10, ...
        'coef0',         NaN, ...
        'coef1',         NaN, ...
        'coef2',         NaN, ...
        'AR_std',        NaN, ...
        'omega',         NaN, ...
        'alpha',         NaN, ...
        'beta',          NaN, ...
        'gamma_release', NaN, ...
        'gamma_ramp',    NaN, ...
        'nu',            NaN, ...
        ... % Release/ramp normalization used during GARCH training
        'release_min',   NaN, ...
        'release_range', NaN, ...
        'ramp_min',      NaN, ...
        'ramp_range',    NaN);
    
    % -------------------------------------------------------------------------
    % Unit 3: The Dalles, predicted from John Day release
    % -------------------------------------------------------------------------
    params(2) = struct( ...
        'name',          'The Dalles', ...
        'unit',          3, ...
        'upstream_unit', 2, ...
        'release_lag',   3, ...
        'coef0',         NaN, ...
        'coef1',         NaN, ...
        'coef2',         NaN, ...
        'AR_const',      NaN, ...
        'AR_coef',       NaN, ...
        'AR_std',        NaN, ...
        'omega',         NaN, ...
        'alpha',         NaN, ...
        'beta',          NaN, ...
        'gamma_release', NaN, ...
        'gamma_ramp',    NaN, ...
        'nu',            NaN, ...
        'release_min',   NaN, ...
        'release_range', NaN, ...
        'ramp_min',      NaN, ...
        'ramp_range',    NaN);
    
    % -------------------------------------------------------------------------
    % Unit 4: Bonneville, predicted from The Dalles release
    % -------------------------------------------------------------------------
    params(3) = struct( ...
        'name',          'Bonneville', ...
        'unit',          4, ...
        'upstream_unit', 3, ...
        'release_lag',   4, ...
        'coef0',         NaN, ...
        'coef1',         NaN, ...
        'coef2',         NaN, ...
        'AR_const',      NaN, ...
        'AR_coef',       NaN, ...
        'AR_std',        NaN, ...
        'omega',         NaN, ...
        'alpha',         NaN, ...
        'beta',          NaN, ...
        'gamma_release', NaN, ...
        'gamma_ramp',    NaN, ...
        'nu',            NaN, ...
        'release_min',   NaN, ...
        'release_range', NaN, ...
        'ramp_min',      NaN, ...
        'ramp_range',    NaN);


    % Hydropower "Per-Unit" Parameters
    sysparams(1) = struct( ...
        'unit',   1, ...      
        'name',   'McNary', ... 
        'a',      1.62, ...    % h_m = a*V_norm + b
        'b',      21.36, ...   
        'min_ut', 0, ...    % kcfs
        'max_ut', 230, ...  % kcfs
        'min_h',  19.7, ...   % m
        'max_h',  23.5, ...   % m
        'min_V',  0, ...      % p.u.
        'max_V',  1.0, ...    % p.u.
        'RR_dn',  -95, ...  % kcfs / hr
        'RR_up',  95, ...   % kcfs / hr
        'F',      980, ...  % MW
        'V0',     0.5, ...
        'kV',     K/234.6);   % p.u. per kcfs-hour     

    sysparams(2) = struct( ...
        'unit',   2, ...      
        'name',   'John Day', ... 
        'a',      3.68, ...    
        'b',      29.17, ...   
        'min_ut', 50, ...   
        'max_ut', 265, ...
        'min_h',  28.3, ...
        'max_h',  32.75, ...
        'min_V',  0, ...
        'max_V',  1.0, ...
        'RR_dn',  -130, ...
        'RR_up',  120, ...
        'F',      2050, ...
        'V0',     .5, ...
        'kV',     K/337.9);   % p.u. per kcfs-hour        

    sysparams(3) = struct( ...
        'unit',   3, ...      
        'name',   'Dalles', ... 
        'a',      3.87, ...    
        'b',      21.76, ...   
        'min_ut', 20, ...   
        'max_ut', 270, ...
        'min_h',  20.5, ...
        'max_h',  26.3, ...
        'min_V',  0, ...
        'max_V',  1.0, ...
        'RR_dn',  -120, ...
        'RR_up',  235, ...
        'F',      1780, ...
        'V0',     0.5, ...
        'kV',     K/41.6);   % p.u. per kcfs-hour  

    sysparams(4) = struct( ...
        'unit',   4, ...      
        'name',   'Bonneville', ... 
        'a',      4.09, ...    
        'b',      16.19, ...   
        'min_ut', 30, ...   
        'max_ut', 260, ...
        'min_h',  12.4, ...
        'max_h',  21.1, ...
        'min_V',  0, ...
        'max_V',  1.0, ...
        'RR_dn',  -120, ...
        'RR_up',  70, ...
        'F',      1150, ...
        'V0',     0.5, ...
        'kV',     K/107.7);   % p.u. per kcfs-hour  
end