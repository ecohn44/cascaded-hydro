function x_slater = findSlater(X_prev, q_t, sys, c)

    n = numel(sys);
    q_t = q_t(:);

    % [V, p, u, spill] for each unit
    x_slater = zeros(4*n, 1);

    for i = 1:n

        % Previous state
        V_prev = X_prev(5*(i-1) + 1);
        u_prev = X_prev(5*(i-1) + 3);

        % Feasible release interval after ramping
        u_min = max(sys(i).min_ut, ...
                    u_prev + sys(i).RR_dn);

        u_max = min(sys(i).max_ut, ...
                    u_prev + sys(i).RR_up);

        if u_min > u_max
            error('No feasible release interval for unit %d.', i);
        end

        % Use minimum feasible turbine release
        u = u_min;

        % First calculate storage without spill
        spill = 0;
        V = V_prev + sys(i).kV*(q_t(i) - u);

        % Spill only enough to satisfy the effective upper bound
        if V > sys(i).V_eff_max
            spill = (V - sys(i).V_eff_max)/sys(i).kV;
            V = sys(i).V_eff_max;
        end

        % Minimum release gives the maximum attainable storage,
        % so spill cannot correct a lower-bound violation
        if V < sys(i).V_eff_min
            error(['No feasible Slater point for unit %d: ' ...
                   'minimum release gives V = %.4f, ' ...
                   'below V_eff_min = %.4f.'], ...
                   i, V, sys(i).V_eff_min);
        end

        % Power at the proposed operating point
        p = c*(sys(i).a*V + sys(i).b)*u;

        if p > sys(i).F + 1e-6
            error(['No feasible Slater point for unit %d: ' ...
                   'power %.4f exceeds capacity %.4f.'], ...
                   i, p, sys(i).F);
        end

        % Store [V, p, u, spill]
        base = 4*(i-1);
        x_slater(base + (1:4)) = [V; p; u; spill];

    end
end