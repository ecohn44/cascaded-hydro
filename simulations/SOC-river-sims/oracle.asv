%% Generalized n-unit Hydropower Optimization Model 
% =======================================================================
% Author: Eliza Cohn
% Description: Solves a single forward simulation/optimization loop over T time steps
%              with DIU/DDU/DET inflow models and JCC volume bounds.
% INPUTS
%   T           : Number of time periods in optimization horizon.
%   c           : Power conversion coefficient (unitless or W·s/m³ per your scaling).
%   q           : Exogenous inflow series (T + lag × n).
%   s           : Struct array of system parameters for each unit i=1..n:
% 
% OUTPUTS
%   model       : Optimization model result for each time step.
%
%   obj         : Total generation over the horizon (sum of p_i).
% 
% -------------------------------------------------------------------------


function [model, obj, X] = oracle(T, c, I, lag, s)


    % Number of units
    n = numel(s);

    % Initialize storage
    X = [];

    % YALMIP reset
    yalmip('clear');


    %% Oracle Optimization Framework 

    % Define Decision Variables 
    V  = sdpvar(n,T);
    p  = sdpvar(n,T);
    u  = sdpvar(n,T);
    sp = sdpvar(n,T);  
    h  = sdpvar(n,T);  

    cons = [];

    % Maximizing Power 
    Objective = sum(p(:)) - 1e-4*sum(sp(:));

    %% Static Constraints
    for i = 1:n
        % Water Release Bounds
        cons = [cons, s(i).min_ut <= u(i,:) <= s(i).max_ut];

        % Feeder Capacity
        cons = [cons, 0 <= p(i,:) <= s(i).F];

        % Spill Bounds
        cons = [cons, 0 <= sp(i,:)];

        % Volume Bounds
        cons = [cons, s(i).min_V <= V(i,:) <= s(i).max_V];
    end

    %% Time-Varying Constraints
    for t = 1:T
       
        if t == 1
            % Initial conditions
            for i = 1:n
                % Mass balance
                cons = [cons, V(i,t) == s(i).V0 + I(i,t) - u(i,t) - sp(i,t)];
    
                % Initial ramp rates
                cons = [cons, u(i,t) == s(i).min_ut];
    
                % Power production (head at initial volume)
                h0 = s(i).a * (s(i).V0^s(i).b);
                cons = [cons, p(i,t) == c*u(i,t)*h0];

            end

        else
            for i = 1:n
                % Ramp rates
                cons = [cons, s(i).RR_dn <= u(i,t) - u(i,t-1) <= s(i).RR_up];
    
                % Power production
                u_min = s(i).min_ut; u_max = s(i).max_ut;
                h_min = s(i).a * s(i).min_V^s(i).b; 
                h_max = s(i).a * s(i).max_V^s(i).b;

                % cons = [cons, p(i,t) == c*u(i,t)*h0];
                
                % Mass balance 
                if i == 1 || t <= lag
                    cons = [cons, V(i,t) == V(i,t-1) + I(i,t) - u(i,t) - sp(i,t)];
                else
                    cons = [cons, V(i,t) == V(i,t-1) + I(i,t) + u(i-1,t-lag) + sp(i-1,t-lag) - u(i,t) - sp(i,t)];
                end
            end 
        end

    end
        
    % Solve optimization 
    options = sdpsettings('solver','gurobi','verbose',0 , 'gurobi.Seed', 1, 'gurobi.Threads', 1);
    model = optimize(cons, -Objective, options);

    disp(model.problem)
    disp(model.info)

    V_opt  = value(V);
    p_opt  = value(p);
    u_opt  = value(u);
    sp_opt = value(sp);

    % Save recorded inflow conditions 
    q = I;
    
    % For all downstream units 
    for i = 2:n
        for t = lag+1:T
            q(i,t) = I(i,t) + u_opt(i-1,t-lag) + sp_opt(i-1,t-lag);
        end
    end

    for i = 1:n
        X = [X, V_opt(i,:)', p_opt(i,:)', u_opt(i,:)', sp_opt(i,:)', q(i,:)'];
    end
    
    obj = sum(p_opt(:));
    
    fprintf('Optimization complete.\n');

end
