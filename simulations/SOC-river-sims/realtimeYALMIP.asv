function [result, obj, X, std_hat] = realtimeYALMIP(t, c, kappa, eps, I_prev, q_error, V_prev, u_prev, V_ref, theta, lag, up_release, sys, model, bounds, framework, tracking)
% =========================================================================
% HEAD FORMULA (linear):
%   h_i = a_i * V_i + b_i          (sys(i).a = slope, sys(i).b = intercept)
%
% POWER FORMULA:
%   p_i = c * h_i * u_i
%       = c * (a_i * V_i + b_i) * u_i
%       = c * a_i * w_i + c * b_i * u_i    where w_i = V_i * u_i
%
% McCormick envelope of w_i = V_i * u_i over [VL_i, VU_i] x [uL_i, uU_i]:
%   MC1:  w_i >= VL*u_i + uL*V_i - VL*uL
%   MC2:  w_i >= VU*u_i + uU*V_i - VU*uU
%   MC3:  w_i <= VU*u_i + uL*V_i - VU*uL
%   MC4:  w_i <= VL*u_i + uU*V_i - VL*uU
% =========================================================================

    % Clear YALMIP internal variable database
    yalmip('clear');

    n = numel(sys);

    % Step 1: Forecast inflow and estimate standard deviation
    q_t = I_prev(:);
    if t > lag
        for i = 2:n
            q_t(i) = model.coef0 + model.coef1 * I_prev(i) + model.coef2 * up_release(i-1);
        end
    end
    std_hat = forecast_error(t, kappa, q_error, up_release, framework, model, sys);

    % Step 2: Compute effective volume bounds (JCC volume shift)
    switch bounds
        case {"det", "jcc-ssh"}
            for i = 1:n
                sys(i).V_eff_max = sys(i).max_V;
                sys(i).V_eff_min = sys(i).min_V;
            end
        case {"jcc-bon"}
            z_score     =  norminv(1 - (eps / (2 * n)));
            V_min_shift =  z_score .* std_hat;
            V_max_shift = -z_score .* std_hat;
            for i = 1:n
                sys(i).V_eff_max = sys(i).max_V + V_max_shift(i);
                sys(i).V_eff_min = max(0, sys(i).min_V + V_min_shift(i));
            end
    end

    % Step 3: Declare YALMIP decision variables
    V  = sdpvar(n, 1);
    p  = sdpvar(n, 1);
    u  = sdpvar(n, 1);
    sp = sdpvar(n, 1);
    d  = sdpvar(n, 1);
    w  = sdpvar(n, 1);

    % Step 4: Build constraint set
    cons = buildConstraints(t, n, V, p, u, sp, d, w, V_prev, u_prev, q_t, V_ref, c, sys);

    % Step 5: Build objective function
    track_coeff = theta ./ ([sys.max_V]' - [sys.min_V]');
    obj   = -sum(p) + 1e-4 * sum(sp) + sum(track_coeff .* d);

    % -----------------------------------------------------------------------
    % Step 6: Solve via YALMIP + Gurobi
    % -----------------------------------------------------------------------
    diagnostics = solveYALMIP(obj, cons, t);

    % -----------------------------------------------------------------------
    % Step 7: Package result into Gurobi-compatible struct (for main driver)
    % -----------------------------------------------------------------------
    result = packageResult(diagnostics, V, p, u, sp, w);

    % -----------------------------------------------------------------------
    % Step 8: Extract primal solution
    % -----------------------------------------------------------------------
    [obj, X] = extractSolution(result, t, n, V, p, u, sp, q_t, V_ref, sys, tracking);

end



function cons = buildConstraints(t, n, V, p, u, sp, d, w, ...
                                         V_prev, u_prev, q_t, V_ref, c, sys)

    cons = [];

    % Unpack reference trajectory bounds
    V_lower = V_ref(1:n);
    V_upper = V_ref(n+1:2*n);

    for i = 1:n

        VL = sys(i).V_eff_min;
        VU = sys(i).V_eff_max;
        uL = sys(i).min_ut;
        uU = sys(i).max_ut;

        % (B1): Storage bounds
        cons = [cons, VL <= V(i) <= VU];                     

        % (B2): Power bounds
        cons = [cons, 0 <= p(i) <= sys(i).F];                

        % (B3) Turbine release bounds + ramp rates
        if t == 1
            % Initial release conditions
            cons = [cons, u(i) == uL];                      
        else
            % (B3) Turbine release bounds
            cons = [cons, uL <= u(i) <= uU];                
            
            % (C2) Ramp-down limit
            cons = [cons, u(i) >= u_prev(i) - sys(i).RR_dn]; 
            
            % (C3) Ramp-up limit
            cons = [cons, u(i) <= u_prev(i) + sys(i).RR_up]; 
        end

        % (B4) Spill non-negativity 
        cons = [cons, sp(i) >= 0];                          

        % (B5) Tracking error non-negativity  
        cons = [cons, d(i) >= 0];                         

        % (B6) McCormick auxiliary bounds:  w(i) in [VL*uL, VU*uU]
        cons = [cons, VL*uL <= w(i) <= VU*uU];              

        % (C1) Mass balance:  V(i) + u(i) + sp(i) = V_prev(i) + q_t(i)
        cons = [cons,  V(i) + u(i) + sp(i) == V_prev(i) + q_t(i)];                  

        % (C4) McCormick envelope for w(i) = V(i) * u(i)
        cons = [cons, ...
            w(i) >= VL*u(i) + uL*V(i) - VL*uL, ...    % MC1 (lower-left)
            w(i) >= VU*u(i) + uU*V(i) - VU*uU, ...    % MC2 (upper-right)
            w(i) <= VU*u(i) + uL*V(i) - VU*uL, ...    % MC3 (upper-left)
            w(i) <= VL*u(i) + uU*V(i) - VL*uU  ...    % MC4 (lower-right)
        ];                                                                 

        % (C5) Power production 
        cons = [cons, p(i) == c * sys(i).a * w(i) + c * sys(i).b * u(i)];          

        % (C6) Tracking error (upper): d(i) >= V(i) - V_upper(i)
        cons = [cons, V(i) - d(i) <= V_upper(i)];           

        % (C7) Tracking error (lower): d(i) >= V_lower(i) - V(i)
        cons = [cons, -V(i) - d(i) <= -V_lower(i)];         

    end
end




