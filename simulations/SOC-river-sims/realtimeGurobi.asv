function [result, obj, X] = realtimeGurobi(t, c, I_t, V_prev, u_prev, V_ref, theta, lag, up_release, sys, model)
% =========================================================================
% INPUTS
%   t        : Current time period index 
%   c        : Power conversion coefficient (scalar)
%   I_t      : Inflow vector for this period (n x 1)
%   V_prev   : Measured storage at start of this period (n x 1) 
%   u_prev   : Turbine release in previous period (n x 1) 
%   V_ref    : Reference storage target from long-term planner (n x 1)
%   theta    : Weight on the volume-tracking penalty term (scalar)
%   sys      : Struct array of per-unit physical parameters:
% =========================================================================

    n = numel(sys);

    % 1:  Calculate inflow forecast 
    q_t = I_t(:);
    if t > lag
        for i = 2:n
            % Regression mean 
            q_t(i) = model.coef0 + model.coef1 * I_t(i) + model.coef2 * up_release(i-1);
        end
    end

    % 2: Define Decision Variables
    nVars  = 5 * n;
    idx_V  = @(i)  (i - 1);
    idx_p  = @(i)  n     + (i - 1);
    idx_u  = @(i)  2*n   + (i - 1);
    idx_sp = @(i)  3*n   + (i - 1);
    idx_d  = @(i)  4*n   + (i - 1);

    % 3: Define Variable Bounds and Objective Coefficients
    [lb, ub, obj_coeff] = buildVariables(t, n, nVars, idx_V, idx_p, idx_u, idx_sp, idx_d, theta, sys);

    % 4: Linear Constraints 
    [A, rhs, sense] = buildLinearConstraints(t, n, lag, nVars, idx_V, idx_p, idx_u, idx_sp, idx_d, V_prev, u_prev, q_t, V_ref, c, sys);

    % 5: Solve Gurobi Model
    result = solveModel(nVars, obj_coeff, A, rhs, sense, lb, ub, t);

    % 6: Extract Solution
    [obj, X] = extractSolution(result, t, n, idx_V, idx_p, idx_u, idx_sp, I_t, V_ref, up_release, sys, model);

end


% Helper: Define upper and lower bounds on decision variables & obj. coefs
function [lb, ub, obj_coeff] = buildVariables(t, n, nVars, idx_V, idx_p, idx_u, idx_sp, idx_d, theta, sys)

    lb        = zeros(nVars, 1);
    ub        =  inf(nVars, 1);
    obj_coeff =  zeros(nVars, 1);

    for i = 1:n

        % B1: Storage V(i)
        lb(idx_V(i)+1)  = sys(i).min_V;
        ub(idx_V(i)+1)  = sys(i).max_V;

        % B2: Power output p(i)
        lb(idx_p(i)+1)  = 0;
        ub(idx_p(i)+1)  = sys(i).F;
        obj_coeff(idx_p(i)+1) = -1;

        % B3: Turbine release u(i)
        if t == 1 % pin for initial state 
            lb(idx_u(i)+1) = sys(i).min_ut;
            ub(idx_u(i)+1) = sys(i).min_ut;
        else
            lb(idx_u(i)+1) = sys(i).min_ut;
            ub(idx_u(i)+1) = sys(i).max_ut;
        end

        % B4: Spill sp(i)
        lb(idx_sp(i)+1) = 0;
        ub(idx_sp(i)+1) = inf;
        obj_coeff(idx_sp(i)+1) = 1e-4;

        % B5: Tracking error d(i)
        lb(idx_d(i)+1)  = 0;
        ub(idx_d(i)+1)  = inf;
        obj_coeff(idx_d(i)+1) = theta / (sys(i).max_V - sys(i).min_V);

    end
end


% Helper: Define linear constraints
function [A, rhs, sense] = buildLinearConstraints(t, n, lag, nVars, idx_V, idx_p, idx_u, idx_sp, idx_d, V_prev, u_prev, q_t, V_ref, c, sys)

    rows  = [];
    cols  = [];
    vals  = [];
    rhs   = [];
    sense = '';
    row   = 0;

    for i = 1:n

        if i > 1 && t > lag
            up_i = up(i-1);                          % up(i) = u(i-1) + sp(i-1) at t-lag
            mu_i = m.coef1*I_t(i) + m.coef2*up_i;    % inflow mean forecast
            
            % (C1) Mass balance: V(i) + u(i) + sp(i) = V_prev(i) + mu(i) 
            row = row + 1;
            rows  = [rows;  row;        row;          row         ];
            cols  = [cols;  idx_V(i)+1; idx_u(i)+1;   idx_sp(i)+1 ];
            vals  = [vals;  1;          1;            1           ];
            rhs   = [rhs;   V_prev(i) + mu_i                      ];
            sense = [sense; '='                                   ];
        else
            % (C1) Mass balance: V(i) + u(i) + sp(i) = V_prev(i) + q_t(i)
            row = row + 1;
            rows  = [rows;  row;        row;          row         ];
            cols  = [cols;  idx_V(i)+1; idx_u(i)+1;   idx_sp(i)+1 ];
            vals  = [vals;  1;          1;            1           ];
            rhs   = [rhs;   V_prev(i) + q_t(i)                    ];
            sense = [sense; '='                                   ];
        

        if t > 1
            % (C2) Ramp-rate lower bound: u(i) >= u_prev(i) + RR_dn
            row = row + 1;
            rows  = [rows;  row        ];
            cols  = [cols;  idx_u(i)+1 ];
            vals  = [vals;  -1         ];
            rhs   = [rhs;   -(u_prev(i) + sys(i).RR_dn)];
            sense = [sense; '<'        ];

            % (C3) Ramp-rate upper bound: u(i) <= u_prev(i) + RR_up
            row = row + 1;
            rows  = [rows;  row        ];
            cols  = [cols;  idx_u(i)+1 ];
            vals  = [vals;  1          ];
            rhs   = [rhs;   u_prev(i) + sys(i).RR_up];
            sense = [sense; '<'        ];
        end

        % (C4) Power Production: p(i) = c * h(i) * u(i) 
        V_norm = (V_prev(i) - sys(i).min_V) / (sys(i).max_V - sys(i).min_V);
        h = sys(i).min_h + (sys(i).max_h - sys(i).min_h) * V_norm^sys(i).b;
        row = row + 1;
        rows  = [rows; row;         row        ];
        cols  = [cols; idx_p(i)+1;  idx_u(i)+1 ];
        vals  = [vals; 1;          -c*h        ];
        rhs   = [rhs;  0                       ];
        sense = [sense; '='                    ];

        % (C5) Tracking error upper:  V(i) - d(i) <= V_ref(i)
        row = row + 1;
        rows  = [rows;  row;         row         ];
        cols  = [cols;  idx_V(i)+1;  idx_d(i)+1  ];
        vals  = [vals;  1;          -1           ];
        rhs   = [rhs;   V_ref(i)                 ];
        sense = [sense; '<'                      ];

        % (C6) Tracking error lower: -V(i) - d(i) <= -V_ref(i)
        row = row + 1;
        rows  = [rows;  row;         row         ];
        cols  = [cols;  idx_V(i)+1;  idx_d(i)+1  ];
        vals  = [vals;  -1;         -1           ];
        rhs   = [rhs;  -V_ref(i)                 ];
        sense = [sense; '<'                      ];

    end

    nCons = row;
    A = sparse(rows, cols, vals, nCons, nVars);
end


% Helper: Solve Gurobi model for the current period (pure LP)
function result = solveModel(nVars, obj_coeff, A, rhs, sense, lb, ub, t_period)

    grb_model.modelname  = sprintf('hydroRT_t%d', t_period);
    grb_model.modelsense = 'min';
    grb_model.obj        = obj_coeff;
    grb_model.A          = A;
    grb_model.rhs        = rhs;
    grb_model.sense      = sense;
    grb_model.lb         = lb;
    grb_model.ub         = ub;
    grb_model.vtype      = repmat('C', nVars, 1);

    % LP
    params.OutputFlag = 0;
    params.Seed       = 1;
    params.TimeLimit  = 10;
    params.Threads    = 0;

    result = gurobi(grb_model, params);

    if strcmp(result.status, 'INFEASIBLE')
        iis = gurobi_iis(grb_model);
        iis_rows = find(iis.Arows);
        for r = iis_rows'
            fprintf('Row %d | sense=%s | rhs=%.6f\n', r, grb_model.sense(r), grb_model.rhs(r));
            [~, cols, vals] = find(grb_model.A(r,:));
            for k = 1:length(cols)
                fprintf('  col %d  coeff=%.6f  lb=%.6f  ub=%.6f\n', ...
                    cols(k), vals(k), grb_model.lb(cols(k)), grb_model.ub(cols(k)));
            end
        end
    end

end


% Helper: Extracts the decision variable values
function [obj, X] = extractSolution(result, t, n, idx_V, idx_p, idx_u, idx_sp, I_t, V_ref, up, sys, m)

    obj = NaN;
    X   = zeros(n, 5);   % [V, p, u, sp, q] per unit

    if strcmp(result.status, 'OPTIMAL') || strcmp(result.status, 'SUBOPTIMAL')
        x = result.x;

        V_out  = zeros(n, 1);
        p_out  = zeros(n, 1);
        u_out  = zeros(n, 1);
        sp_out = zeros(n, 1);
        q_out = I_t;

        for i = 1:n
            V_out(i)  = x(idx_V(i)+1);
            p_out(i)  = x(idx_p(i)+1);
            u_out(i)  = x(idx_u(i)+1);
            sp_out(i) = x(idx_sp(i)+1);
            if t > lag && i > 1
                q_out(i) = m.coef1*I_t(i) +  m.coef2 * up(i-1);
            end
        end

        % Normalised volume tracking error
        track_err = zeros(n, 1);
        for i = 1:n
            vol_range    = sys(i).max_V - sys(i).min_V;
            track_err(i) = abs(V_out(i) - V_ref(i)) / vol_range;
        end

        fprintf('[t=%3d]  Power: %7.3f  Spill: %6.3f  TrackErr: %.4f\n', ...
            t, sum(p_out), sum(sp_out), mean(track_err));

        obj = sum(p_out);

        % Store Results: X = [V, p, u, sp, q]
        for i = 1:n
            X(i,:) = [V_out(i), p_out(i), u_out(i), sp_out(i), q_out(i)];
        end

    else
        warning('[t=%d] Gurobi status: %s. Returning NaN obj and zero X.', ...
            t, result.status);
    end
end
